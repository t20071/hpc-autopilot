# Optional: real email delivery from the /api/send-email function (set these in Vercel > Settings > Environment Variables)
RESEND_API_KEY=
MAIL_FROM="HPC Autopilot <hpc@your-domain.edu>"
# Comma-separated domains that may receive mail, e.g. iimu.ac.in,students.iimu.ac.in (required; prevents abuse)
ALLOWED_EMAIL_DOMAINS=

# Optional: password-protect the whole site and its API (browser sign-in prompt)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# AI assistant (Groq). Optional GROQ_MODEL overrides the default openai/gpt-oss-120b
GROQ_API_KEY=
